# Salin file ini jadi .env lalu isi:  cp .env.example .env
# Setiap kali .env diubah, jalankan ulang:  docker compose up -d

# ================= WAJIB DIISI =================

# Token akses Threads (long-lived, berlaku 60 hari; diperpanjang otomatis oleh workflow tiap minggu)
THREADS_ACCESS_TOKEN=
# ID akun Threads. Biarkan "me" kalau tidak tahu.
THREADS_USER_ID=me
# API key Claude dari https://platform.claude.com
ANTHROPIC_API_KEY=
# Kata sandi untuk webhook posting manual. Isi teks acak yang panjang.
WEBHOOK_SECRET=ganti-dengan-teks-acak-yang-panjang

# ================= JADWAL POSTING =================

GENERIC_TIMEZONE=Asia/Jakarta
# Format cron: menit jam tanggal bulan hari-dalam-minggu
# "0 7,12,19,21 * * *" = setiap hari jam 07:00, 12:00, 19:00, dan 21:00
POST_CRON="0 7,12,19,21 * * *"
# Jeda acak 0-N menit setelah jam posting, supaya tidak kelihatan seperti bot. 0 = tepat waktu.
POST_JITTER_MINUTES=10

# ================= CERITA =================

# Daftar kategori cerita, pisahkan dengan |. Setiap posting memilih satu secara acak.
STORY_NICHES="cerita horor kos-kosan atau rumah tua|kisah lucu kejadian di kantor|kisah inspiratif perantau yang merintis dari nol|cerita cinta masa SMA yang bikin senyum-senyum|kisah haru tentang orang tua|pengalaman kocak naik transportasi umum"
# Gaya bahasa
STORY_STYLE="Bahasa Indonesia santai sehari-hari pakai aku-kamu, seperti orang curhat di Threads. Kalimat pendek, jujur, dan relate."
# Siapa naratornya (kosongkan = orang pertama "aku")
STORY_PERSONA=
# Instruksi tambahan bebas untuk AI, misalnya "selipkan pesan moral di akhir"
STORY_EXTRA_INSTRUCTIONS=
# Jumlah bagian utas (dipilih acak di antara min dan max, maksimal 10)
STORY_MIN_PARTS=3
STORY_MAX_PARTS=6
# Tambahkan nomor (1/5), (2/5), ... di akhir setiap bagian
THREAD_NUMBERING=true
# Topik Threads: "auto" = dipilih AI, "off" = tanpa topik, atau tulis topik tetap, misalnya "Cerita Horor"
THREADS_TOPIC_TAG=auto

# ================= AI (CLAUDE) =================

AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (makin tinggi makin "mikir", makin mahal)
AI_EFFORT=medium
# "default" = kalau model menolak permintaan, API otomatis coba model cadangan. "off" untuk mematikan.
AI_FALLBACK=default

# ================= LAINNYA =================

# true = cerita hanya dibuat (lihat hasilnya di Executions), TIDAK diposting. Ubah ke false kalau sudah yakin.
DRY_RUN=true
# Jeda (detik) antara membuat container dan mempublikasikan setiap bagian
PUBLISH_DELAY_SECONDS=10
# Berapa judul cerita terakhir yang diingat supaya ide tidak berulang
HISTORY_SIZE=30
# App Secret Threads (opsional, hanya untuk menukar token short-lived lewat scripts/threads-token.js)
THREADS_APP_SECRET=

# ================= GAMBAR DI POST PERTAMA (opsional) =================

# off    = tanpa gambar
# pexels = foto stok gratis dari Pexels yang cocok dengan cerita (butuh PEXELS_API_KEY)
# ai     = ilustrasi buatan AI dari GAMBAR_AI_URL
# url    = acak dari daftar GAMBAR_URLS (gambar milikmu sendiri)
# Kolom "gambar" di antrian Google Sheets / field "gambar" di webhook selalu dipakai lebih dulu.
GAMBAR_SUMBER=off
# API key gratis dari https://www.pexels.com/api/
PEXELS_API_KEY=
# Tambahkan "📷 Nama Fotografer / Pexels" di post pertama (kalau masih muat)
GAMBAR_KREDIT=true
# Template URL generator gambar AI. {prompt} dan {seed} diganti otomatis.
# Kosongkan untuk memakai default Pollinations (gratis, tanpa key):
# https://image.pollinations.ai/prompt/{prompt}?width=1080&height=1350&seed={seed}&nologo=true&model=flux
GAMBAR_AI_URL=
# Gaya ilustrasi AI (bahasa Inggris)
GAMBAR_GAYA="cinematic digital illustration, moody lighting, rich colors"
# Daftar URL gambar (JPEG/PNG, publik), pisahkan dengan |
GAMBAR_URLS=
# Jeda (detik) sebelum post bergambar dipublikasikan, supaya Threads selesai memproses gambarnya
GAMBAR_JEDA_DETIK=30

# ================= ANTRIAN GOOGLE SHEETS (opsional) =================

# URL aplikasi web Apps Script (berakhiran /exec). Kosongkan kalau tidak pakai antrian.
GSHEET_URL=
# Harus sama dengan SECRET di google-sheets/antrian.gs
GSHEET_SECRET=
# urut      = setiap jadwal POST_CRON mengambil satu baris teratas yang statusnya kosong
# terjadwal = setiap baris diposting tepat di tanggal & jam-nya (pakai POST_CRON yang sering, misalnya */10 * * * *)
ANTRIAN_MODE=urut
# Kalau antrian habis (mode urut): acak = AI memilih kategori dari STORY_NICHES | lewati = tidak posting
ANTRIAN_KOSONG=acak

# ================= NOTIFIKASI TELEGRAM (opsional) =================

# Token bot dari @BotFather. Kosongkan kalau tidak mau notifikasi.
TELEGRAM_BOT_TOKEN=
# Chat ID tujuan (angka; grup diawali tanda minus). Cari dengan:
#   docker compose exec n8n node /scripts/telegram.js chat-id
TELEGRAM_CHAT_ID=
# semua = utas terposting, cerita mode uji, token diperpanjang, dan error | error = hanya error | off = mati
TELEGRAM_NOTIFY=semua

# ================= VPS + HTTPS (opsional, lihat docs/PANDUAN-VPS.md) =================

# Alamat n8n, misalnya n8n.domainkamu.com atau n8n.203-0-113-5.sslip.io
N8N_DOMAIN=
# Hapus tanda # di depan baris berikut untuk menyalakan HTTPS otomatis (Caddy) di VPS
#COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml

# ================= PENGATURAN n8n =================

# Alamat n8n yang dipakai di link "Lihat di n8n" (Telegram). Diisi otomatis kalau HTTPS aktif.
WEBHOOK_URL=http://localhost:5678/
# n8n hanya bisa dibuka lewat http://localhost:5678 (atau SSH tunnel). Diubah ke true otomatis kalau HTTPS aktif.
N8N_SECURE_COOKIE=false
N8N_DIAGNOSTICS_ENABLED=false
